{
  "name": "teamrecall",
  "version": "0.1.0",
  "description": "Git-native team memory that shows up automatically in Claude Code, Codex, and Cursor",
  "type": "module",
  "bin": {
    "teamrecall": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run --testTimeout 20000",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "memory",
    "team",
    "code-review",
    "claude",
    "cursor",
    "codex",
    "engineering",
    "knowledge"
  ],
  "author": "wangwu-30",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangwu-30/teamrecall.git"
  },
  "homepage": "https://github.com/wangwu-30/teamrecall",
  "bugs": {
    "url": "https://github.com/wangwu-30/teamrecall/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "yaml": "^2.3.4",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
